# コピーして .env にする。.env は絶対に Git に入れない（.gitignore 済み）
# 初期PIN：初回ログイン時に各自が必ず変更します。推測されにくい6〜8桁にしてください
PORTAL_INITIAL_PIN=
CRM_INITIAL_PIN=
# セッション署名用の長いランダム文字列：  openssl rand -hex 32
PORTAL_SESSION_SECRET=
CRM_SESSION_SECRET=
# B) Cloudflare Tunnel を使う場合のみ（ダッシュボードで作成したトークン）
CLOUDFLARE_TUNNEL_TOKEN=
PORTAL_PORT=3000
CRM_PORT=3001

# 会社アカウント（Google / Microsoft）でのログイン統一（任意）。Cloudflare Access のアプリごとに作成
#   TEAM_DOMAIN: Zero Trust の「チームドメイン」例 example.cloudflareaccess.com / AUD: アプリの「Application Audience (AUD) Tag」
PORTAL_ACCESS_TEAM_DOMAIN=
PORTAL_ACCESS_AUD=
CRM_ACCESS_TEAM_DOMAIN=
CRM_ACCESS_AUD=
# 1 にすると従業員番号 + PIN のログインを止め、会社アカウントのみにする（先に SSO で入れることを確認してから）
ACCESS_ONLY=0

# 勤怠を外部の勤怠SaaSに任せる（ポータルの勤怠・打刻・Excel連携を非表示）：PORTAL_ATTENDANCE=off、PORTAL_ATTENDANCE_URL に勤怠SaaSのURL
# 変更後は docker compose up -d --build で作り直す
PORTAL_ATTENDANCE=
PORTAL_ATTENDANCE_URL=
